          },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "spanNulls": true,
            "showPoints": "never"
          },
          "unit": "watt"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "description": "PV + generator is roughly consumption + battery charging + losses."
    },
