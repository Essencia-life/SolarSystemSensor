    {
      "id": 14,
      "type": "timeseries",
      "title": "Overloads (per 24 h)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "increase(datahub_xt1_overload_count{device_id=\"$device\"}[24h])",
          "legendFormat": "overloads",
