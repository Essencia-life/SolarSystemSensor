# Copy to /etc/studer-sensor/studer-sensor.env and chmod 600.
# Never commit real API keys.
SERIAL_PORT=/dev/ttyUSB0
# The Xcom-232i is fixed to 38400 baud, 8 data bits, even parity, 1 stop bit; leave unchanged.
SERIAL_BAUDRATE=38400
SERIAL_PARITY=E
SERIAL_TIMEOUT=3.0
DEVICE_ID=studer-device-1
# One READ_PROPERTY per entry: address:info (see docs/INSTALL.md). Empty = first Xtender defaults.
SCOM_INFOS=101:3000,101:3005,101:3011,101:3012,101:3021,101:3022,101:3087,101:3088
# VarioString (PV): 701:15004 PV voltage, 701:15010 PV power, 701:15017 yield today, 701:15108 state
# BSP: 601:7002 state of charge, 601:7004 remaining autonomy (min), 601:7003 power
SCOM_SRC_ADDR=1
DATAHUB_URL=https://datahub.example.invalid
DATAHUB_API_KEY=replace-me
DATAHUB_TIMEOUT=10
SPOOL_PATH=/var/lib/studer-sensor/spool.sqlite3
POLL_INTERVAL=30
LOG_LEVEL=INFO
