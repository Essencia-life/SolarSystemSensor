# Copy to /etc/studer-sensor/studer-sensor.env and chmod 600.
# Never commit real API keys.
SERIAL_PORT=/dev/ttyUSB0
# The Xcom-232i is fixed to 38400 baud, 8 data bits, even parity, 1 stop bit; leave unchanged.
SERIAL_BAUDRATE=38400
SERIAL_PARITY=E
SERIAL_TIMEOUT=3.0
DEVICE_ID=studer-device-1
# One READ_PROPERTY per entry: address:info (see docs/INSTALL.md). Empty = first Xtender defaults.
# Off-grid setup without BSP and without BTS (no state of charge, no battery temperature):
#   Xtender 101: 3000 battery voltage, 3005 battery current (negative = discharge),
#     3136 output power (consumption), 3022 output current, 3028 operating state,
#     3010 battery cycle phase, 3083 consumption today, 3078 battery discharge today,
#     3045 overload count
#   Generator on the AC input (verify wiring first, see docs/METRICS.md):
#     3011 input voltage, 3012 input current, 3137 input power, 3081 energy from source today,
#     3020 transfer relay
#   VarioString 701: 15004 PV voltage, 15010 PV power, 15017 yield today, 15108 state
SCOM_INFOS=101:3000,101:3005,101:3136,101:3022,101:3028,101:3010,101:3083,101:3078,101:3045,101:3011,101:3012,101:3137,101:3081,101:3020,701:15004,701:15010,701:15017,701:15108
# With a BSP later: 601:7002 state of charge, 601:7004 remaining autonomy (min), 601:7005 temperature
SCOM_SRC_ADDR=1
DATAHUB_URL=https://datahub.example.invalid
DATAHUB_API_KEY=replace-me
DATAHUB_TIMEOUT=10
SPOOL_PATH=/var/lib/studer-sensor/spool.sqlite3
POLL_INTERVAL=300
LOG_LEVEL=INFO
